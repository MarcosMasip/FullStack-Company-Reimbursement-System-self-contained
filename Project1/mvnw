#!/bin/sh
# Apache Maven Wrapper startup script (simplified)
MAVEN_PROJECTBASEDIR=$(cd "`dirname "$0"`"; pwd -P)
WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading Maven Wrapper..." >&2
  MAVEN_WRAPPER_DL_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"
  mkdir -p "$MAVEN_PROJECTBASEDIR/.mvn/wrapper" || true
  curl -fsSL -o "$WRAPPER_JAR" "$MAVEN_WRAPPER_DL_URL" || wget -q -O "$WRAPPER_JAR" "$MAVEN_WRAPPER_DL_URL" || {
    echo "Failed to download maven-wrapper.jar" >&2; exit 1; }
fi

exec "${JAVA_HOME:+$JAVA_HOME/bin/}java" -classpath "$WRAPPER_JAR" -Dmaven.multiModuleProjectDirectory="$MAVEN_PROJECTBASEDIR" org.apache.maven.wrapper.MavenWrapperMain "$@"
